{{!-- A page's inline FAQ block: the handful of questions that page's own
      visitors ask most, resolved from src/models/faqs/*.json by their ids (see
      src/controllers/faqLib.js).

      This content is deliberately here and should stay: page-specific Q&A is
      useful to a reader at the moment of enquiry, and useful for relevance and
      answer-engine retrieval, whether or not it is marked up. What does NOT
      belong here is the FAQPage JSON-LD -- that lives on /faqs/ alone, so the
      site has one authoritative machine-readable copy instead of seven. See
      the comment in src/pages/faqs.hbs. --}}
<div class="page-header">
  <h2>Frequently Asked Questions</h2>
</div>

<div class="divide-y divide-sand-200 overflow-hidden rounded-card border border-sand-200 bg-white">
  {{#each this}}
    <details class="group p-4 sm:p-5">
      <summary
        class="flex cursor-pointer list-none items-start justify-between gap-3 rounded-sm font-semibold text-ink-900 marker:content-none focus-visible:outline focus-visible:outline-3 focus-visible:outline-accent-500 focus-visible:outline-offset-2"
      >
        <span><span class="text-brand-700">Q{{offset @index}}:</span> {{q}}</span>
        <span
          aria-hidden="true"
          class="mt-1 shrink-0 text-brand-700 transition-transform duration-150 group-open:rotate-180"
        >&#9662;</span>
      </summary>
      <div class="mt-3 text-ink-700">
        <span class="badge mb-2 inline-flex">Answer</span>
        <p class="mt-2 mb-0">{{a}}</p>
      </div>
    </details>
  {{/each}}
</div>

<p class="mt-4 mb-0">
  <a href="{{link "faqs" canonical=true}}">All questions and answers &rarr;</a>
</p>

{{#extend "layout"}}

{{#content "head"}}
<script type="application/ld+json">
{{{stringify (serviceSchema model.heading description (canonical) price=config.business.sessions.atA1K9)}}}
</script>
<script type="application/ld+json">
{{{stringify (breadcrumbList (breadcrumb))}}}
</script>
{{/content}}

{{#content "intro"}}
  {{#if model.components.intro}}
    {{> (lookup model.components 'intro')}}
  {{/if}}
{{/content}}

{{#content "main"}}
<div class="page-header">
  <h1 class="mb-0 text-3xl sm:text-4xl">{{model.heading}}</h1>
</div>

{{> "at-a-glance"}}

<div class="grid gap-8 lg:grid-cols-2">
  <div class="prose-site">
    {{#if model.components.details}}
      {{> (lookup model.components 'details')}}
    {{/if}}
  </div>
  <div class="space-y-6">
    {{> "behavioural-consultations/shared/vet-referrals" }}
    {{> "behavioural-consultations/shared/what-to-expect-in-a-behavioural-consultation" }}
  </div>
</div>

{{#if model.faqs}}
  <div class="mt-10">
    {{> "faqs" model.faqs }}
  </div>
{{/if}}

{{!-- The page used to end at a "Contact Gaynor" button, which asked a worried
      owner to navigate before they could say anything. The same enquiry form
      the course pages use now sits here instead, under the same Netlify form
      name so it lands in one inbox; the model's `enquiryKind` is what tells
      the two apart in the notification's subject line. The form carries the
      three-step "How booking works" strip inside its own card, keyed off this
      model's `glance` — see the comment in courses/enquiry.hbs. --}}
{{> "courses/enquiry"}}

{{/content}}

{{#content "scripts"}}{{/content}}

{{/extend}}

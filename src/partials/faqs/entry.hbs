{{!-- One FAQ entry as rendered on the /faqs/ hub — shared by each grouped
      section and by the "More answers" block in src/pages/faqs.hbs, so the
      two never drift into two different markups for the same kind of thing.
      `id`/`data-faq` are what src/assets/js/site.js's search and deep-link
      handling (#q-<id>) both key off. --}}
<details id="q-{{id}}" data-faq class="group scroll-mt-24 p-4 sm:p-5">
  <summary
    class="flex cursor-pointer list-none items-start justify-between gap-3 rounded-sm font-semibold text-ink-900 marker:content-none focus-visible:outline focus-visible:outline-3 focus-visible:outline-accent-500 focus-visible:outline-offset-2"
  >
    <span>{{q}}</span>
    <span aria-hidden="true"
      class="mt-1 shrink-0 text-brand-700 transition-transform duration-150 group-open:rotate-180"
    >&#9662;</span>
  </summary>
  <div class="mt-3 text-ink-700">
    <p class="mt-2 mb-0">{{a}}</p>
  </div>
</details>

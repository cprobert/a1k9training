{{#extend "layout"}}

{{#content "head"}}
<script type="application/ld+json">
{{!-- One-to-one carries no `price` (faqLib's [PRICES] block filters on it), so
      its Offer comes from the shared sessions fact instead. --}}
{{#if (eq model.glance "session")}}
{{{stringify (serviceSchema model.heading description (canonical) price=config.business.sessions.atA1K9)}}}
{{else}}
{{{stringify (serviceSchema model.heading description (canonical) price=model.price)}}}
{{/if}}
</script>
<script type="application/ld+json">
{{{stringify (breadcrumbList (breadcrumb))}}}
</script>
{{/content}}

{{#content "intro"}}
  {{#if model.components.intro}}
    {{> (lookup model.components 'intro')}}
  {{/if}}
  {{!-- An action above the fold. Anchors to the enquiry form at the foot
        rather than to another page, so deciding and asking are one step. --}}
  <p class="mt-6 mb-0">
    <a href="#enquire" class="btn btn-accent">Ask about this course</a>
  </p>
{{/content}}

{{#content "main"}}
  <div class="page-header">
      <h1>{{model.heading}}</h1>
  </div>

  {{!-- The price/next-start line that used to sit under the h1 is now one row
        of the at-a-glance block, beside the rest of the facts people write in
        to ask for. One-to-one renders its "session" shape instead. --}}
  {{> "at-a-glance"}}

  <div class="grid gap-8 lg:grid-cols-3">
    <div class="prose-site lg:col-span-2">
      {{#if model.videoId}}
      <div class="mb-6 aspect-video overflow-hidden rounded-card not-prose">
        <iframe
          src="https://www.youtube-nocookie.com/embed/{{model.videoId}}"
          title="{{model.videoTitle}}"
          width="100%" height="100%"
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          class="size-full border-0"></iframe>
      </div>
      {{/if}}
      {{#if  model.components.details}}
        {{> (lookup model.components 'details')}}
      {{/if}}
    </div>
    {{#if  model.components.testimonial}}
    <aside class="callout prose-site lg:col-span-1">
      {{> (lookup model.components 'testimonial')}}
    </aside>
    {{/if}}
  </div>

  {{#if  model.faqs}}
    <div class="mt-10">
      {{> "faqs" model.faqs }}
    </div>
  {{/if}}

  {{!-- Booking this course is the page's primary action; the ladder's next
        step is genuinely secondary, so it renders after the enquiry form and
        styles its link accordingly. "How booking works" is inside the form's
        own card now — see the comment in courses/enquiry.hbs. --}}
  {{> "courses/enquiry"}}

  {{> "courses/ladder"}}

{{/content}}

{{#content "scripts"}}{{/content}}

{{/extend}}

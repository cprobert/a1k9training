{{#extend "layout"}}

{{#content "head"}}
<script type="application/ld+json">
{{{stringify (breadcrumbList (breadcrumb))}}}
</script>
{{!-- The site's only FAQPage block. Course and consultation pages show the same
      answers inline as human-readable content, which stays; only the JSON-LD is
      centralised here, so there is one authoritative machine-readable copy
      rather than the same answers marked up on seven URLs.

      Not an SEO mechanism: Google restricted FAQ rich results to authoritative
      government and health sites in August 2023 and withdrew them altogether in
      May 2026, and says no special markup is needed for AI Overviews or AI Mode.
      It is kept because FAQPage is a valid schema.org type that other consumers
      of structured data can read, and one clean copy costs nothing.

      Every question and answer here must also be visible on this page --
      qa/preview.mjs checks that, not just that the block exists. --}}
<script type="application/ld+json">
{{{stringify (faqPage model.allFaqs)}}}
</script>
{{/content}}

{{#content "main"}}
  <div class="page-header">
    <h1>Frequently asked questions</h1>
    <p>{{model.faqCount}} answers about dog training courses and behavioural consultations with Gaynor Probert at
      A1K9 Behaviour and Training Academy, near Swansea: which course suits your dog, who can join a class, and
      what to expect from a consultation. Prices, days and dates are on each course page.</p>
  </div>

  {{!-- Revealed by src/assets/js/site.js: without JavaScript the box would do
        nothing, so it stays hidden and every answer is on the page anyway. --}}
  <div data-faq-search hidden class="mt-6 rounded-card border border-sand-200 bg-white p-4 sm:p-5">
    <label for="faq-search" class="block font-medium">Search the questions</label>
    <input id="faq-search" type="search" autocomplete="off" data-faq-input
      placeholder="rescue, two dogs, season, reactive&hellip;"
      class="mt-1 w-full rounded-md border border-sand-300 bg-white px-3 py-2">
    <p class="mt-2 mb-0 text-sm text-ink-500" data-faq-count aria-live="polite"></p>
    {{!-- Opens every answer, the "More answers" block included, for a
          read-through — and /faqs/?all does the same on arrival, so a review
          link needs no clicking. --}}
    <button type="button" data-faq-expand aria-pressed="false"
      class="mt-3 text-sm font-medium text-brand-700 underline underline-offset-4 hover:text-brand-800">Expand all answers</button>
  </div>

  <nav aria-label="Question sections" class="mt-8">
    <ul class="flex flex-wrap gap-2" data-faq-jump>
      {{#each model.sections}}
        <li>
          <a href="#{{key}}"
            class="inline-block rounded-pill border border-sand-300 bg-white px-3 py-1 text-sm text-ink-700 no-underline hover:border-brand-600 hover:text-brand-700">{{title}}</a>
        </li>
      {{/each}}
    </ul>
  </nav>

  {{#each model.sections}}
    <section id="{{key}}" data-faq-section class="mt-10 scroll-mt-24">
      <h2 class="font-display text-2xl text-ink-900">{{title}}</h2>
      <div class="mt-4 divide-y divide-sand-200 overflow-hidden rounded-card border border-sand-200 bg-white">
        {{#each faqs}}
          {{> "faqs/entry" this}}
        {{/each}}
      </div>
    </section>
  {{/each}}

  {{#if model.moreFaqs.length}}
    {{!-- Long-tail questions: findable by the search box above, but left out
          of the curated sections and the "N answers" standfirst so the
          headline count stays a reviewed list rather than everything anyone
          has ever asked. Closed by default; src/assets/js/site.js opens it
          when a search matches something inside, and #q-<id> deep links to
          one of these open it too. --}}
    <section class="mt-10">
      <details data-faq-more class="group rounded-card border border-sand-200 bg-white">
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-card p-4 font-display text-xl text-ink-900 marker:content-none sm:p-5 focus-visible:outline focus-visible:outline-3 focus-visible:outline-accent-500 focus-visible:outline-offset-2"
        >
          <span>More answers: {{model.moreFaqs.length}} less-common questions</span>
          <span aria-hidden="true"
            class="shrink-0 text-brand-700 transition-transform duration-150 group-open:rotate-180"
          >&#9662;</span>
        </summary>
        <div class="divide-y divide-sand-200 border-t border-sand-200">
          {{#each model.moreFaqs}}
            {{> "faqs/entry" this}}
          {{/each}}
        </div>
      </details>
    </section>
  {{/if}}

  <p data-faq-empty hidden class="mt-8 rounded-card border border-sand-200 bg-sand-50 p-5 text-ink-700">
    Nothing here matches that. Try a different word, or
    <a href="{{link "contact" canonical=true}}">ask Gaynor directly</a>, who answers every enquiry herself.
  </p>

  <div class="mt-12 rounded-card border border-sand-200 bg-white p-6 sm:p-8">
    <h2 class="mb-2 font-display text-xl text-ink-900">Still not sure where to start?</h2>
    <p class="mb-6">Tell Gaynor a little about your dog and she will come back to you with whether
      this is the right course to start on.</p>
    <div class="flex flex-wrap gap-3">
      <a href="{{link "contact" canonical=true}}" class="btn btn-accent">Ask Gaynor</a>
      <a href="{{link "courses/index" canonical=true}}" class="btn btn-secondary">See the courses</a>
    </div>
  </div>
{{/content}}

{{/extend}}

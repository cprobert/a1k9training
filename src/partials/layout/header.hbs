<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="author" content="Gaynor Probert">
<link rel="icon" href="/favicon.ico" sizes="any">
<meta name="theme-color" content="#1f5136">
<!-- analytics: intentionally empty — add a tag here when one is chosen -->

<link rel="canonical" href="{{canonical}}">

{{!--
  Open Graph / Twitter: what a link pasted into Facebook, WhatsApp or LinkedIn
  previews as. Title, description and URL are the page's own, so sharing a
  course page previews that course. The image is one purpose-made 1200x630
  card for every page (business.socialCard, cut by scripts/social-card.mjs),
  not the page's hero: platforms crop a hero to whatever they like, and the
  width/height tags must state the file's real size or the card renders
  blurred or letterboxed. absUrl because scrapers ignore a relative image.
  The LocalBusiness JSON-LD below still names the page's hero via heroImage.
--}}
<meta property="og:type" content="website">
<meta property="og:title" content="{{title}}">
{{#if description}}
  <meta property="og:description" content="{{description}}">
{{/if}}
<meta property="og:url" content="{{canonical}}">
<meta property="og:image" content="{{absUrl (asset config.business.socialCard.path)}}">
<meta property="og:image:width" content="{{config.business.socialCard.width}}">
<meta property="og:image:height" content="{{config.business.socialCard.height}}">
<meta property="og:image:alt" content="{{config.business.socialCard.alt}}">
<meta property="og:site_name" content="{{config.business.name}}">
<meta name="twitter:card" content="summary_large_image">

{{!--
  LocalBusiness JSON-LD, every page. Fields left out on purpose rather than
  invented: no street address or opening hours are sourced anywhere in this
  repo, so schema.org gets only what's actually here (index.hbs, the tel:
  link in every "Call Me" / "Get in Touch" link).
--}}
<script type="application/ld+json">
{{{stringify (localBusiness model)}}}
</script>

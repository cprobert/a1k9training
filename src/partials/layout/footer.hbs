{{!--
  Site footer. Carries the contact details deliberately: the phone number used
  to live only on the home page, and the footer is where people look for it
  when the page they are on has not offered one.
--}}
<footer class="mt-auto border-t border-sand-200 bg-sand-100">
  <div class="mx-auto grid max-w-content gap-8 px-4 py-10 sm:px-6 sm:grid-cols-2 lg:grid-cols-3 lg:px-8">

    <div>
      <h2 class="mb-2 font-display text-lg text-ink-900">Talk to Gaynor</h2>
      <p class="mb-2">
        <a href="tel:{{config.business.telephone}}"
          class="text-lg font-semibold text-brand-700 no-underline hover:underline">{{config.business.telephoneDisplay}}</a>
      </p>
      <p class="m-0 text-sm text-ink-600">
        Or <a href="{{link "contact" canonical=true}}" class="font-medium text-brand-700 underline underline-offset-4 hover:text-brand-800">send a message</a>
        and she will get back to you.
      </p>
    </div>

    <div>
      <h2 class="mb-2 font-display text-lg text-ink-900">Where we train</h2>
      <p class="m-0 text-sm text-ink-600">
        Two venues near Swansea, South Wales — the A1K9 Training Grounds at
        Pontarddulais, and Llys Nini Animal Centre at Penllergaer when the
        weather is against us.
        <a href="{{link "contact" canonical=true}}" class="font-medium text-brand-700 underline underline-offset-4 hover:text-brand-800">See both on the map</a>.
      </p>
    </div>

    <div>
      <h2 class="mb-2 font-display text-lg text-ink-900">Explore</h2>
      <ul class="m-0 space-y-1 text-sm">
        <li><a href="{{link "courses/index" canonical=true}}" class="font-medium text-brand-700 underline underline-offset-4 hover:text-brand-800">Dog training courses</a></li>
        <li><a href="{{link "behavioural-consultations/index" canonical=true}}" class="font-medium text-brand-700 underline underline-offset-4 hover:text-brand-800">Behavioural consultations</a></li>
        <li><a href="{{link "about/index" canonical=true}}" class="font-medium text-brand-700 underline underline-offset-4 hover:text-brand-800">About Gaynor and the team</a></li>
        <li><a href="{{link "faqs" canonical=true}}" class="font-medium text-brand-700 underline underline-offset-4 hover:text-brand-800">Frequently asked questions</a></li>
      </ul>
    </div>

  </div>

  <div class="border-t border-sand-200">
    <div class="mx-auto flex max-w-content flex-col-reverse items-start justify-between gap-3 px-4 py-6 sm:flex-row sm:items-center sm:px-6 lg:px-8">
      <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
        <p class="m-0 text-sm text-ink-600">
          &copy; {{config.year}} Gaynor Probert
        </p>
        <ul class="social-links m-0 flex list-none items-center gap-3 p-0">
          <li>
            <a href="{{config.business.social.facebook}}" target="_blank" rel="noopener external" aria-label="Gaynor Probert on Facebook" class="icon-link text-brand-700 hover:text-brand-800">
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.987C18.343 21.128 22 16.991 22 12z"/></svg>
            </a>
          </li>
          <li>
            <a href="{{config.business.social.youtube}}" target="_blank" rel="noopener external" aria-label="Gaynor Probert on YouTube" class="icon-link text-brand-700 hover:text-brand-800">
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true"><path d="M23.498 6.186a2.994 2.994 0 0 0-2.107-2.117C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.391.524A2.994 2.994 0 0 0 .502 6.186 31.09 31.09 0 0 0 0 12a31.09 31.09 0 0 0 .502 5.814 2.994 2.994 0 0 0 2.107 2.117c1.886.524 9.391.524 9.391.524s7.505 0 9.391-.524a2.994 2.994 0 0 0 2.107-2.117A31.09 31.09 0 0 0 24 12a31.09 31.09 0 0 0-.502-5.814zM9.75 15.568V8.432L15.818 12l-6.068 3.568z"/></svg>
            </a>
          </li>
          <li>
            <a href="{{config.business.social.linkedin}}" target="_blank" rel="noopener external" aria-label="Gaynor Probert on LinkedIn" class="icon-link text-brand-700 hover:text-brand-800">
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452z"/></svg>
            </a>
          </li>
        </ul>
      </div>
      <p class="m-0">
        <a href="#" class="text-sm font-medium text-brand-700 underline underline-offset-4 hover:text-brand-800">
          Back to top
        </a>
      </p>
    </div>
  </div>
</footer>
